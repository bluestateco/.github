{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "enabledManagers": ["terraform", "github-actions"],
  "packageRules": [
    {
      "description": "Auto-merge patch Terraform module bumps after CI",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge patch and digest GitHub Actions bumps after CI",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group GitHub Actions updates into one PR per repo",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Pin GitHub Actions to SHA digests (supply chain security)",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
